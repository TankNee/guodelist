{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Guodelist",
  "version": "0.9.8",
  "identifier": "com.guodelist.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev --port 5173",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Guodelist",
        "width": 1280,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#ebe8e3"
      },
      {
        "label": "widget",
        "url": "index.html?window=widget",
        "title": "Guodelist 桌面小组件",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
